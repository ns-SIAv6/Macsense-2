# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SENTRY_DSN: Sentry error-reporting endpoint.
# Obtain from your Sentry project: Settings > Client Keys (DSN).
# Leave blank in development; the crash-reporter falls back to a no-op.
# Required for release builds when CRASH_REPORTING_ENABLED=true.
SENTRY_DSN=

# Optional cloud project backup (offline-first: optional).
# SUPABASE_URL: Your Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Supabase anon/public API key for PostgREST calls.
# Use the public anon/publishable key only.
# Never put a service_role or secret key in the Android client.
# Find in: Supabase Dashboard > Settings > API > anon public
SUPABASE_ANON_KEY=

# SUPABASE_ACCESS_TOKEN: Authenticated user session token.
# Set only after a real authenticated user session is available. Do not bake a long-lived token
# into a release artifact; leaving this blank keeps cloud backup unavailable by default.
SUPABASE_ACCESS_TOKEN=
