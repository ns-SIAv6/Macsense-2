# Required: your real Gemini API key. This must ONLY ever live on the server.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional: port the gateway listens on. Defaults to 8787.
PORT=8787

# Optional: comma-separated list of allowed CORS origins.
# Leave unset to allow all origins (fine for a mobile-only client that
# doesn't send browser CORS preflights, but set this if you also serve
# a web client from a known origin).
CORS_ORIGINS=

# Optional: shared bearer token the Android client must send as
# `Authorization: Bearer <token>`. Leave unset to disable auth (only
# recommended for local development).
MACSENSE_CLIENT_TOKEN=

# Optional: max requests allowed per IP per rate-limit window.
RATE_LIMIT_MAX=30

# Optional: rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
